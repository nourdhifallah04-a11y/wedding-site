# Example environment variables for production
# Copy to .env and fill with real values before deploying

# Server port (optional)
PORT=3002

# SMTP (email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=supersecret

# Email to receive notifications about new messages
ADMIN_EMAIL=admin@example.com

# Frontend: URL de l'API backend (utilisé en production)
# Exemple: REACT_APP_API_URL=https://api.monsite.com
REACT_APP_API_URL=
# Example .env - copy to .env and fill values
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password_or_app_password
ADMIN_EMAIL=you@example.com
PORT=3001
